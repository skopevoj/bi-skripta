{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@skripta/ui/interactive": ["../src/interactive/index.ts"],
      "@skripta/ui/math": ["../src/math/index.ts"]
    }
  },
  "include": ["src"]
}
