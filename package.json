{
  "name": "bi-skripta",
  "private": true,
  "description": "Skripta k předmětům FIT ČVUT (BI-KAB, BI-KOM, BI-OOP) se sdíleným design systémem @skripta/ui.",
  "workspaces": [
    "packages/*",
    "packages/ui/playground",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:kab": "npm run dev -w apps/kab",
    "dev:kom": "npm run dev -w apps/kom -- -p 3131",
    "dev:oop": "npm run dev -w apps/oop -- -p 3123",
    "build:kab": "npm run build -w apps/kab",
    "build:kom": "npm run build -w apps/kom",
    "build:oop": "npm run build -w apps/oop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "playground": "npm run dev -w packages/ui/playground"
  },
  "engines": {
    "node": ">=20"
  }
}
